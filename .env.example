# Local presentation secrets — copy to .env (gitignored) for your notes.
# Flutter does not load .env automatically; pass passwords as dart-defines:
#
# flutter run -d chrome --dart-define=BUSHEL_MOCK=true --dart-define=BUSHEL_MOCK_PASSWORD=your-password
#
# Optional per-account overrides:
# --dart-define=BUSHEL_MOCK_PASSWORD_A=...
# --dart-define=BUSHEL_MOCK_PASSWORD_B=...
#
# Existing Firebase Auth accounts: a@a.co (John C / MCFB leader) and b@b.co.

BUSHEL_MOCK_PASSWORD=
