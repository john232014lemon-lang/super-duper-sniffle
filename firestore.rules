rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Kid Mode uses the parent's identity, never a separate child credential.
    function parentMode() {
      return signedIn() && (!exists(/databases/$(database)/documents/families/$(request.auth.uid))
        || get(/databases/$(database)/documents/families/$(request.auth.uid)).data.activeChildId == '');
    }
    function coordinates(bankId) {
      return parentMode()
        && get(/databases/$(database)/documents/coordinatorApplications/$(request.auth.uid)/banks/$(bankId)).data.status == 'approved';
    }
    function groupPath(sid) { return /databases/$(database)/documents/groups/$(sid); }
    function regPath(uid, sid) { return /databases/$(database)/documents/registrations/$(uid)/shifts/$(sid); }
    function shiftPath(sid) { return /databases/$(database)/documents/shifts/$(sid); }
    function attendancePath(uid, pid, sid) { return /databases/$(database)/documents/attendance/$(sid)/families/$(uid)/attendanceEntries/$(pid); }
    function revokedPath(uid, sid) { return /databases/$(database)/documents/attendanceRevocations/$(sid)/revokedFamilies/$(uid); }
    function shiftLeader(sid) {
      let shift = get(shiftPath(sid)).data;
      return signedIn() && shift.creatorUid == request.auth.uid && coordinates(shift.bankId);
    }
    function attendingMember(uid, pid, sid) {
      return existsAfter(regPath(uid, sid)) && (pid == 'parent'
        || pid in getAfter(regPath(uid, sid)).data.get('childIds', []));
    }
    function member(sid) { return signedIn() && request.auth.uid in get(groupPath(sid)).data.members; }
    function beforeSeats(uid, sid) { return exists(regPath(uid, sid)) ? 1 + get(regPath(uid, sid)).data.get('childIds', []).size() : 0; }
    function afterSeats(uid, sid) { return existsAfter(regPath(uid, sid)) ? 1 + getAfter(regPath(uid, sid)).data.get('childIds', []).size() : 0; }
    function quorum(sid, target) {
      let g = get(groupPath(sid)).data;
      let vote = get(/databases/$(database)/documents/groups/$(sid)/votes/$(target)).data;
      return member(sid) && target != request.auth.uid && target in g.members
        && vote.version == g.version && vote.voters.size() * 3 >= g.members.size() * 2;
    }
    function childVote(sid, target) {
      return get(/databases/$(database)/documents/groups/$(sid)/votes/$(target)).data;
    }
    function childQuorum(sid, target) {
      let g = get(groupPath(sid)).data;
      let vote = childVote(sid, target);
      return member(sid)
        && vote.keys().hasOnly(['version', 'voters', 'parentUid', 'childId'])
        && vote.parentUid is string
        && vote.childId is string
        && vote.parentUid in g.members
        && vote.parentUid != request.auth.uid
        && vote.childId in g.get('childMembers', {}).get(vote.parentUid, {})
        && target == vote.parentUid + '::' + vote.childId
        && vote.version == g.version
        && vote.voters.size() * 3 >= g.members.size() * 2;
    }
    function removedTarget(sid) {
      return get(groupPath(sid)).data.members.keys().removeAll(getAfter(groupPath(sid)).data.members.keys())[0];
    }
    function removal(sid, target) {
      return quorum(sid, target) && !existsAfter(regPath(target, sid))
        && !(target in getAfter(groupPath(sid)).data.members)
        && !(target in getAfter(groupPath(sid)).data.get('childMembers', {}))
        && target in getAfter(groupPath(sid)).data.banned
        && getAfter(revokedPath(target, sid)).data.revokedAt == request.time;
    }
    function childRemoval(sid, parentUid, childId) {
      let target = parentUid + '::' + childId;
      let beforeIds = resource.data.get('childIds', []);
      let afterIds = request.resource.data.get('childIds', []);
      return childQuorum(sid, target)
        && childVote(sid, target).parentUid == parentUid
        && childVote(sid, target).childId == childId
        && childId in beforeIds
        && !(childId in afterIds)
        && afterIds.size() == beforeIds.size() - 1
        && beforeIds.hasAll(afterIds)
        && !(childId in getAfter(groupPath(sid)).data.get('childMembers', {}).get(parentUid, {}))
        && getAfter(groupPath(sid)).data.seats[parentUid] == 1 + afterIds.size()
        && getAfter(shiftPath(sid)).data.signupCount == get(shiftPath(sid)).data.signupCount - 1;
    }
    function childSeatRemovalQuorum(sid, parentUid) {
      let before = get(groupPath(sid)).data.get('childMembers', {}).get(parentUid, {});
      let after = getAfter(groupPath(sid)).data.get('childMembers', {}).get(parentUid, {});
      let childKeys = before.keys();
      return (childKeys.size() >= 1 && !(childKeys[0] in after) && childQuorum(sid, parentUid + '::' + childKeys[0]))
        || (childKeys.size() >= 2 && !(childKeys[1] in after) && childQuorum(sid, parentUid + '::' + childKeys[1]))
        || (childKeys.size() >= 3 && !(childKeys[2] in after) && childQuorum(sid, parentUid + '::' + childKeys[2]))
        || (childKeys.size() >= 4 && !(childKeys[3] in after) && childQuorum(sid, parentUid + '::' + childKeys[3]))
        || (childKeys.size() >= 5 && !(childKeys[4] in after) && childQuorum(sid, parentUid + '::' + childKeys[4]));
    }
    function registrationRemovedChild(sid, parentUid) {
      let beforeIds = resource.data.get('childIds', []);
      let afterIds = request.resource.data.childIds;
      return beforeIds.size() == afterIds.size() + 1
        && beforeIds.hasAll(afterIds)
        && (
          (beforeIds.size() >= 1 && !(beforeIds[0] in afterIds) && childRemoval(sid, parentUid, beforeIds[0]))
          || (beforeIds.size() >= 2 && !(beforeIds[1] in afterIds) && childRemoval(sid, parentUid, beforeIds[1]))
          || (beforeIds.size() >= 3 && !(beforeIds[2] in afterIds) && childRemoval(sid, parentUid, beforeIds[2]))
          || (beforeIds.size() >= 4 && !(beforeIds[3] in afterIds) && childRemoval(sid, parentUid, beforeIds[3]))
          || (beforeIds.size() >= 5 && !(beforeIds[4] in afterIds) && childRemoval(sid, parentUid, beforeIds[4]))
        );
    }
    function text(value, limit) { return value is string && value.size() > 0 && value.size() <= limit && value.matches('(?s).*\\S.*'); }
    // Administrator-owned, expiring allowlist. A client build flag grants no access.
    function mockQrEnabled(sid) {
      let config = get(/databases/$(database)/documents/settings/mockQr).data;
      return config.enabled == true && request.time < config.expiresAt
        && sid in config.shiftIds;
    }
    function realQrProof(sid) {
      let shift = get(shiftPath(sid)).data;
      return hashing.sha256(request.resource.data.tokenProof).toHexString().lower() == shift.qrTokenHash
        && request.time >= shift.startsAt - duration.value(30, 'm')
        && request.time < shift.qrExpiresAt
        && request.time < shift.startsAt + duration.value(4, 'h');
    }
    function mockQrProof(sid, pid) {
      let token = get(/databases/$(database)/documents/mockQrTokens/$(sid)).data;
      return mockQrEnabled(sid) && pid == 'parent'
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.preferredRole == 'volunteer'
        && request.auth.uid != get(shiftPath(sid)).data.creatorUid
        && request.resource.data.status == 'pending'
        && hashing.sha256(request.resource.data.tokenProof).toHexString().lower() == token.qrTokenHash
        && request.time < token.expiresAt;
    }
    match /settings/mockQr {
      allow get: if signedIn();
      // Trusted administrator writes only.
    }
    match /mockQrTokens/{sid} {
      allow get: if signedIn() && (shiftLeader(sid) || (parentMode() && member(sid)));
      allow create, update: if shiftLeader(sid) && mockQrEnabled(sid)
        && request.resource.data.keys().hasOnly(['qrTokenHash', 'expiresAt'])
        && request.resource.data.qrTokenHash is string
        && request.resource.data.qrTokenHash.matches('^[0-9a-f]{64}$')
        && (resource == null || request.resource.data.qrTokenHash != resource.data.qrTokenHash)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'm');
    }
    match /coordinatorApplications/{uid}/banks/{bankId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if parentMode() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/banks/$(bankId))
        && request.resource.data.keys().hasOnly(['name', 'contact', 'reason', 'status', 'submittedAt'])
        && text(request.resource.data.name, 80) && text(request.resource.data.contact, 160)
        && text(request.resource.data.reason, 2000)
        && request.resource.data.status == 'pending' && request.resource.data.submittedAt == request.time;
      // Only a trusted administrator can approve, reject, or reopen an application.
    }
    match /families/{uid} {
      function owner() { return signedIn() && request.auth.uid == uid; }
      function entryChange(field, limit, maxEntries) {
        let old = resource == null ? {} : resource.data[field];
        let next = request.resource.data[field];
        let changed = next.keys().removeAll(old.keys());
        return next == old || (next is map && next.size() <= maxEntries
          && next.diff(old).removedKeys().size() == 0 && next.diff(old).changedKeys().size() == 0
          && changed.size() == 1 && text(next[changed[0]], limit));
      }
      function targetsChange() {
        let old = resource == null ? {} : resource.data.get('challengeTargets', {});
        let next = request.resource.data.get('challengeTargets', {});
        let added = next.keys().removeAll(old.keys());
        let oldChallenges = resource == null ? {} : resource.data.challenges;
        return next == old || (parentMode() && next is map
          && next.diff(old).removedKeys().size() == 0 && next.diff(old).changedKeys().size() == 0
          && added.size() == 1 && !(added[0] in oldChallenges)
          && added[0] in request.resource.data.challenges
          && next[added[0]] is int && next[added[0]] >= 1 && next[added[0]] <= 100);
      }
      allow get: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['children', 'challenges', 'activeChildId', 'challengeTargets'])
        && entryChange('children', 80, 50) && entryChange('challenges', 160, 100)
        && targetsChange()
        && (parentMode() || (request.resource.data.children == resource.data.children && request.resource.data.challenges == resource.data.challenges))
        && request.resource.data.activeChildId is string
        && (request.resource.data.activeChildId == '' || request.resource.data.activeChildId in request.resource.data.children);
    }
    match /banks/{bankId} {
      allow read: if signedIn();
      // Catalog records are managed by trusted project administrators only.
    }
    match /coordinatorAccess/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      // Never writable by clients, including coordinators.
    }
    match /shifts/{shiftId} {
      function validSchedule() {
        let d = request.resource.data;
        let parts = d.time.split(':');
        let minutes = int(parts[0]) * 60 + int(parts[1]);
        return d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && d.date is timestamp && d.date == d.date.date()
          && d.startsAt is timestamp
          && d.utcOffsetMinutes is int && d.utcOffsetMinutes >= -840 && d.utcOffsetMinutes <= 840
          && d.startsAt == d.date + duration.value(minutes - d.utcOffsetMinutes, 'm')
          // Minute precision allows a start in the current minute.
          && d.startsAt + duration.value(1, 'm') > request.time
          && d.startsAt <= request.time + duration.value(365, 'd');
      }
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['bankId', 'creatorUid', 'title', 'date', 'time', 'startsAt', 'utcOffsetMinutes', 'station', 'instructions', 'capacity', 'signupCount', 'createdAt'])
        && request.resource.data.bankId is string
        && exists(/databases/$(database)/documents/banks/$(request.resource.data.bankId))
        && coordinates(request.resource.data.bankId)
        && request.resource.data.creatorUid == request.auth.uid
        && text(request.resource.data.title, 40)
        && request.resource.data.time is string && validSchedule()
        && text(request.resource.data.station, 30)
        && request.resource.data.get('instructions', '') is string
        && request.resource.data.get('instructions', '').size() <= 500
        && request.resource.data.date is timestamp
        && request.resource.data.date >= timestamp.date(2000, 1, 1)
        && request.resource.data.date < timestamp.date(2101, 1, 1)
        && request.resource.data.capacity is int && request.resource.data.capacity > 0 && request.resource.data.capacity <= 500
        && request.resource.data.signupCount == 0
        && request.resource.data.createdAt == request.time
        && !exists(groupPath(shiftId))
        && getAfter(groupPath(shiftId)).data == {'members': {}, 'seats': {}, 'childMembers': {}, 'version': 0, 'banned': []};

      function ownCountChange() {
        let delta = afterSeats(request.auth.uid, shiftId) - beforeSeats(request.auth.uid, shiftId);
        return delta != 0 && request.resource.data.signupCount == resource.data.signupCount + delta;
      }
      function removalCountChange() {
        let target = removedTarget(shiftId);
        return removal(shiftId, target)
          && request.resource.data.signupCount == resource.data.signupCount - beforeSeats(target, shiftId);
      }
      function childRemovalCountChange() {
        let beforeSeats = get(groupPath(shiftId)).data.seats;
        let afterSeats = getAfter(groupPath(shiftId)).data.seats;
        let seatKeys = beforeSeats.keys();
        return request.resource.data.signupCount == resource.data.signupCount - 1
          && getAfter(groupPath(shiftId)).data.members == get(groupPath(shiftId)).data.members
          && getAfter(groupPath(shiftId)).data.version == get(groupPath(shiftId)).data.version
          && beforeSeats.diff(afterSeats).affectedKeys().size() == 1
          && (
            (seatKeys.size() >= 1 && beforeSeats[seatKeys[0]] == afterSeats[seatKeys[0]] + 1
              && childSeatRemovalQuorum(shiftId, seatKeys[0]))
            || (seatKeys.size() >= 2 && beforeSeats[seatKeys[1]] == afterSeats[seatKeys[1]] + 1
              && childSeatRemovalQuorum(shiftId, seatKeys[1]))
            || (seatKeys.size() >= 3 && beforeSeats[seatKeys[2]] == afterSeats[seatKeys[2]] + 1
              && childSeatRemovalQuorum(shiftId, seatKeys[2]))
            || (seatKeys.size() >= 4 && beforeSeats[seatKeys[3]] == afterSeats[seatKeys[3]] + 1
              && childSeatRemovalQuorum(shiftId, seatKeys[3]))
            || (seatKeys.size() >= 5 && beforeSeats[seatKeys[4]] == afterSeats[seatKeys[4]] + 1
              && childSeatRemovalQuorum(shiftId, seatKeys[4]))
            || (seatKeys.size() >= 6 && beforeSeats[seatKeys[5]] == afterSeats[seatKeys[5]] + 1
              && childSeatRemovalQuorum(shiftId, seatKeys[5]))
            || (seatKeys.size() >= 7 && beforeSeats[seatKeys[6]] == afterSeats[seatKeys[6]] + 1
              && childSeatRemovalQuorum(shiftId, seatKeys[6]))
            || (seatKeys.size() >= 8 && beforeSeats[seatKeys[7]] == afterSeats[seatKeys[7]] + 1
              && childSeatRemovalQuorum(shiftId, seatKeys[7]))
          );
      }
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signupCount'])
        && request.resource.data.signupCount is int
        && request.resource.data.signupCount >= 0
        && request.resource.data.signupCount <= resource.data.capacity
        && (ownCountChange() || removalCountChange() || childRemovalCountChange());
      allow update: if shiftLeader(shiftId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qrTokenHash', 'qrExpiresAt', 'qrCode'])
        && !('qrCode' in request.resource.data)
        && request.resource.data.qrTokenHash is string
        && request.resource.data.qrTokenHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.qrTokenHash != resource.data.get('qrTokenHash', '')
        && request.resource.data.qrExpiresAt is timestamp
        && request.time >= resource.data.startsAt - duration.value(30, 'm')
        && request.resource.data.qrExpiresAt > request.time
        && request.resource.data.qrExpiresAt <= request.time + duration.value(15, 'm')
        && request.resource.data.qrExpiresAt <= resource.data.startsAt + duration.value(4, 'h');
    }
    // Collection-group queries must constrain ownerUid or leaderUid to auth.uid.
    // These grants are read-only; writes are allowed only at the canonical path.
    match /{path=**}/attendanceEntries/{pid} {
      allow list: if signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.leaderUid == request.auth.uid);
    }
    match /{path=**}/revokedFamilies/{uid} {
      allow list: if signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.leaderUid == request.auth.uid);
    }
    match /attendanceRevocations/{sid}/revokedFamilies/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || get(shiftPath(sid)).data.creatorUid == request.auth.uid);
      allow create: if parentMode() && quorum(sid, uid)
        && !existsAfter(regPath(uid, sid))
        && !(uid in getAfter(groupPath(sid)).data.members)
        && uid in getAfter(groupPath(sid)).data.banned
        && request.resource.data.keys().hasOnly(['ownerUid', 'leaderUid', 'shiftId', 'revokedAt'])
        && request.resource.data.ownerUid == uid && request.resource.data.shiftId == sid
        && request.resource.data.leaderUid == get(shiftPath(sid)).data.creatorUid
        && request.resource.data.revokedAt == request.time;
    }
    match /attendance/{sid}/families/{uid}/attendanceEntries/{pid} {
      function owner() { return signedIn() && request.auth.uid == uid; }
      function childBadge() {
        return owner() && pid != 'parent' && resource.data.status == 'confirmed'
          && !existsAfter(revokedPath(uid, sid))
          && !('badgeId' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['badgeId'])
          && request.resource.data.badgeId in ['donkey', 'bunny', 'fox', 'bear', 'panda', 'frog', 'bee', 'butterfly', 'chick', 'turtle', 'carrot', 'corn', 'tomato', 'broccoli', 'pepper', 'pumpkin', 'apple', 'strawberry', 'watermelon', 'grapes', 'sunflower', 'sprout', 'cactus', 'tree', 'clover'];
      }
      allow get: if owner() || (signedIn() && get(shiftPath(sid)).data.creatorUid == request.auth.uid);
      allow create: if owner() && parentMode() && member(sid) && attendingMember(uid, pid, sid)
        && !existsAfter(revokedPath(uid, sid))
        && request.resource.data.keys().hasOnly(['ownerUid', 'participantId', 'shiftId', 'leaderUid', 'name', 'tokenProof', 'status', 'checkedInAt', 'confirmedAt', 'mockQr'])
        && request.resource.data.ownerUid == uid && request.resource.data.participantId == pid
        && request.resource.data.shiftId == sid
        && request.resource.data.leaderUid == get(shiftPath(sid)).data.creatorUid
        && text(request.resource.data.name, 80)
        && request.resource.data.tokenProof is string
        && request.resource.data.tokenProof.matches('^[0-9a-f]{64}$')
        && ((request.resource.data.get('mockQr', false) == true && mockQrProof(sid, pid))
          || (!('mockQr' in request.resource.data) && realQrProof(sid)))
        && request.resource.data.checkedInAt == request.time
        && ((request.resource.data.status == 'pending' && !('confirmedAt' in request.resource.data))
          || (pid == 'parent' && shiftLeader(sid) && request.resource.data.status == 'confirmed' && request.resource.data.confirmedAt == request.time));
      allow update: if childBadge() || (shiftLeader(sid) && attendingMember(uid, pid, sid)
        && !existsAfter(revokedPath(uid, sid))
        && resource.data.status == 'pending'
        && request.resource.data.status == 'confirmed'
        && request.resource.data.confirmedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt']));
      // No deletes or client point totals. Removal uses an immutable revocation marker.
    }
    match /rewardPreferences/{uid}/people/{pid} {
      function owner() { return signedIn() && request.auth.uid == uid; }
      allow read: if owner();
      allow create, update: if owner() && pid != 'parent'
        && request.resource.data.keys().hasOnly(['badgeId', 'shiftId'])
        && request.resource.data.shiftId is string
        && !existsAfter(revokedPath(uid, request.resource.data.shiftId))
        && getAfter(attendancePath(uid, pid, request.resource.data.shiftId)).data.status == 'confirmed'
        && getAfter(attendancePath(uid, pid, request.resource.data.shiftId)).data.badgeId == request.resource.data.badgeId;
    }
    match /registrations/{uid}/shifts/{shiftId} {
      function owner() { return signedIn() && request.auth.uid == uid; }
      function shift() { return /databases/$(database)/documents/shifts/$(shiftId); }
      allow read: if owner();
      allow create: if owner() && parentMode()
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time
        && exists(shift())
        && getAfter(shift()).data.signupCount == get(shift()).data.signupCount + 1
        && getAfter(shift()).data.signupCount <= get(shift()).data.capacity
        && uid in getAfter(groupPath(shiftId)).data.members
        && !(uid in get(groupPath(shiftId)).data.members)
        && !(uid in get(groupPath(shiftId)).data.banned);
      allow update: if owner() && parentMode()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['childIds'])
        && request.resource.data.childIds is list
        && request.resource.data.childIds.size() == request.resource.data.childIds.toSet().size()
        && request.resource.data.childIds.hasOnly(get(/databases/$(database)/documents/families/$(uid)).data.children.keys())
        && ((request.resource.data.childIds.size() == resource.data.get('childIds', []).size() + 1
              && request.resource.data.childIds.hasAll(resource.data.get('childIds', [])))
          || (request.resource.data.childIds.size() == resource.data.get('childIds', []).size() - 1
              && resource.data.get('childIds', []).hasAll(request.resource.data.childIds)))
        && getAfter(shift()).data.signupCount == get(shift()).data.signupCount + request.resource.data.childIds.size() - resource.data.get('childIds', []).size()
        && getAfter(groupPath(shiftId)).data.seats[uid] == 1 + request.resource.data.childIds.size()
        && getAfter(groupPath(shiftId)).data.get('childMembers', {}).get(uid, {}).keys()
             .hasOnly(request.resource.data.childIds)
        && request.resource.data.childIds.hasOnly(
             getAfter(groupPath(shiftId)).data.get('childMembers', {}).get(uid, {}).keys());
      allow update: if parentMode()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['childIds'])
        && request.resource.data.childIds is list
        && request.resource.data.childIds.size() == request.resource.data.childIds.toSet().size()
        && registrationRemovedChild(shiftId, uid);
      allow delete: if parentMode() && (owner() || removal(shiftId, uid))
        && !(uid in getAfter(groupPath(shiftId)).data.members)
        && !(uid in getAfter(groupPath(shiftId)).data.get('childMembers', {}))
        && getAfter(shift()).data.signupCount == get(shift()).data.signupCount - 1 - resource.data.get('childIds', []).size()
        && getAfter(shift()).data.signupCount >= 0;
    }
    match /groups/{shiftId} {
      allow get: if member(shiftId) || shiftLeader(shiftId);
      allow create: if signedIn() && !exists(shiftPath(shiftId))
        && getAfter(shiftPath(shiftId)).data.creatorUid == request.auth.uid
        && request.resource.data == {'members': {}, 'seats': {}, 'childMembers': {}, 'version': 0, 'banned': []};
      function childRosterOk(uid, next) {
        let kids = next.get('childMembers', {}).get(uid, {});
        let ids = getAfter(regPath(uid, shiftId)).data.get('childIds', []);
        return kids.keys().hasOnly(ids) && ids.hasOnly(kids.keys())
          && next.get('childMembers', {}).diff(resource.data.get('childMembers', {})).affectedKeys().hasOnly([uid]);
      }
      function ownMembership() {
        let uid = request.auth.uid;
        let before = beforeSeats(uid, shiftId);
        let after = afterSeats(uid, shiftId);
        let next = request.resource.data;
        return next.banned == resource.data.banned
          && next.members.diff(resource.data.members).affectedKeys().hasOnly([uid])
          && next.seats.diff(resource.data.seats).affectedKeys().hasOnly([uid])
          && ((before == 0 && after == 1 && !(uid in resource.data.banned)
              && text(next.members[uid], 80) && next.seats[uid] == 1 && next.version == resource.data.version + 1
              && !(uid in next.get('childMembers', {})))
            || (before > 0 && after == 0 && !(uid in next.members) && !(uid in next.seats)
              && !(uid in next.get('childMembers', {})) && next.version == resource.data.version + 1)
            || (before > 0 && after > 0 && before != after && next.members == resource.data.members
              && next.seats[uid] == after && next.version == resource.data.version
              && childRosterOk(uid, next)));
      }
      function removeMember() {
        let target = removedTarget(shiftId);
        let next = request.resource.data;
        return removal(shiftId, target)
          && next.members.diff(resource.data.members).affectedKeys().hasOnly([target])
          && next.seats.diff(resource.data.seats).affectedKeys().hasOnly([target])
          && next.get('childMembers', {}).diff(resource.data.get('childMembers', {})).affectedKeys().hasOnly([target])
          && !(target in next.seats) && !(target in next.get('childMembers', {}))
          && next.version == resource.data.version + 1
          && next.banned == resource.data.banned.concat([target]);
      }
      function removeChildForParent(parentUid) {
        let next = request.resource.data;
        let before = resource.data.get('childMembers', {}).get(parentUid, {});
        let after = next.get('childMembers', {}).get(parentUid, {});
        let childKeys = before.keys();
        return next.members == resource.data.members
          && next.banned == resource.data.banned
          && next.version == resource.data.version
          && next.seats.diff(resource.data.seats).affectedKeys().hasOnly([parentUid])
          && next.seats[parentUid] == resource.data.seats[parentUid] - 1
          && resource.data.get('childMembers', {}).diff(next.get('childMembers', {})).affectedKeys().hasOnly([parentUid])
          && (
            (childKeys.size() >= 1 && !(childKeys[0] in after) && childQuorum(shiftId, parentUid + '::' + childKeys[0]))
            || (childKeys.size() >= 2 && !(childKeys[1] in after) && childQuorum(shiftId, parentUid + '::' + childKeys[1]))
            || (childKeys.size() >= 3 && !(childKeys[2] in after) && childQuorum(shiftId, parentUid + '::' + childKeys[2]))
            || (childKeys.size() >= 4 && !(childKeys[3] in after) && childQuorum(shiftId, parentUid + '::' + childKeys[3]))
            || (childKeys.size() >= 5 && !(childKeys[4] in after) && childQuorum(shiftId, parentUid + '::' + childKeys[4]))
          );
      }
      function removeChildMember() {
        let seatKeys = resource.data.seats.keys();
        return (seatKeys.size() >= 1 && removeChildForParent(seatKeys[0]))
          || (seatKeys.size() >= 2 && removeChildForParent(seatKeys[1]))
          || (seatKeys.size() >= 3 && removeChildForParent(seatKeys[2]))
          || (seatKeys.size() >= 4 && removeChildForParent(seatKeys[3]))
          || (seatKeys.size() >= 5 && removeChildForParent(seatKeys[4]))
          || (seatKeys.size() >= 6 && removeChildForParent(seatKeys[5]))
          || (seatKeys.size() >= 7 && removeChildForParent(seatKeys[6]))
          || (seatKeys.size() >= 8 && removeChildForParent(seatKeys[7]));
      }
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'seats', 'version', 'banned', 'childMembers'])
        && (ownMembership() || removeMember() || removeChildMember());
      match /votes/{target} {
        allow read: if member(shiftId);
        function validAdultVote() {
          let g = get(groupPath(shiftId)).data;
          let previous = resource == null || resource.data.version != g.version ? [] : resource.data.voters;
          return parentMode() && member(shiftId) && target in g.members && target != request.auth.uid
            && request.resource.data.keys().hasOnly(['version', 'voters'])
            && request.resource.data.version == g.version
            && !(request.auth.uid in previous)
            && request.resource.data.voters == previous.concat([request.auth.uid]);
        }
        function validChildVote() {
          let g = get(groupPath(shiftId)).data;
          let previous = resource == null || resource.data.version != g.version ? [] : resource.data.voters;
          let parentUid = request.resource.data.parentUid;
          let childId = request.resource.data.childId;
          return parentMode() && member(shiftId)
            && parentUid is string && childId is string
            && parentUid in g.members
            && parentUid != request.auth.uid
            && childId in g.get('childMembers', {}).get(parentUid, {})
            && target == parentUid + '::' + childId
            && request.resource.data.keys().hasOnly(['version', 'voters', 'parentUid', 'childId'])
            && request.resource.data.version == g.version
            && !(request.auth.uid in previous)
            && request.resource.data.voters == previous.concat([request.auth.uid]);
        }
        allow create, update: if validAdultVote() || validChildVote();
      }
    }
    // Only the explicitly shared phone is exposed, never private profile fields.
    match /coordinatorContacts/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || parentMode());
      allow create, update: if parentMode() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['phone'])
        && request.resource.data.phone is string
        && (request.resource.data.phone == '' || request.resource.data.phone.matches('^[+]?[0-9]{7,15}$'))
        && request.resource.data.phone == getAfter(/databases/$(database)/documents/profiles/$(uid)).data.get('phone', '');
      allow delete: if parentMode() && request.auth.uid == uid;
    }
    match /profiles/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      // preferredRole changes presentation only; no permissions live here.
      allow get, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['name', 'preferredRole', 'familyAccount', 'phone', 'updatedAt'])
        && request.resource.data.get('phone', '') is string
        && (request.resource.data.get('phone', '') == '' || request.resource.data.phone.matches('^[+]?[0-9]{7,15}$'))
        && (request.resource.data.get('phone', '') == (resource == null ? '' : resource.data.get('phone', ''))
          || (parentMode() && getAfter(/databases/$(database)/documents/coordinatorContacts/$(uid)).data.phone == request.resource.data.get('phone', '')))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.name.matches('.*[^ ].*')
        && request.resource.data.preferredRole in ['volunteer', 'coordinator']
        && request.resource.data.familyAccount is bool
        && request.resource.data.updatedAt == request.time;
    }
    // Slice 16 only: each authenticated adult can test their own connection.
    match /smokeTests/{uid}/runs/{runId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow get, delete: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['message', 'createdAt'])
        && request.resource.data.message == 'Bushel connection test'
        && request.resource.data.createdAt == request.time;
      // Diagnostic updates and queries remain closed.
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
